# /opt/strands-cloud/.env on the droplet (never committed). Read by compose and Caddy.
# Public hostname of the dashboard; its DNS A record points at the droplet's reserved IP.
DASH_DOMAIN=dash.example.com
# GitHub login (oauth2-proxy): OAuth app id/secret and who may sign in (comma-separated GitHub logins).
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_GITHUB_USERS=Jacob-Brokloff
# DASHBOARD_AUTH_TOKEN and the cookie secret live in secrets.env, made on the droplet by deploy.sh.
# Agent model (scripts/agent.py), when used.
OPENAI_BASE_URL=
OPENAI_API_KEY=
MODEL_ID=
