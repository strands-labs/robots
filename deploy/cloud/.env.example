# /opt/strands-cloud/.env on the droplet (never committed). Read by compose and Caddy.
# Public hostname of the dashboard; its DNS A record points at the droplet's reserved IP.
DASH_DOMAIN=dash.example.com
# Let's Encrypt contact (optional).
ACME_EMAIL=
# Optional static bearer token for scripts/CI calling the API (passkeys are the normal login).
DASHBOARD_AUTH_TOKEN=
# Agent model (scripts/agent.py), when used.
OPENAI_BASE_URL=
OPENAI_API_KEY=
MODEL_ID=
